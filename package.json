{
  "name": "create-efforge",
  "version": "0.2.1",
  "description": "Start an Effect app with database, auth, and Cloudflare services already wired together",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "create",
    "effect",
    "scaffold",
    "tanstack-start",
    "template",
    "typescript"
  ],
  "homepage": "https://github.com/amagdy46/efforge#readme",
  "bugs": "https://github.com/amagdy46/efforge/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amagdy46/efforge.git"
  },
  "bin": {
    "create-efforge": "dist/bin.js",
    "efforge": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "start": "node src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "build": "vp pack",
    "prepack": "pnpm build",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "smoke:pack": "node scripts/smoke-pack.ts",
    "brand": "node scripts/brand/build.ts",
    "brand:outline": "node scripts/brand/outline.ts",
    "docs:addons": "node scripts/docs/addons.ts"
  },
  "devDependencies": {
    "@clack/prompts": "1.9.0",
    "@effect/platform-node": "4.1.4",
    "@effect/vitest": "4.1.4",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/saira-semi-condensed": "5.3.0",
    "@types/node": "26.6.6",
    "effect": "4.1.4",
    "jsonc-parser": "3.3.1",
    "opentype.js": "2.0.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "picocolors": "1.1.1",
    "playwright": "1.65.1",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
