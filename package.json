{
  "name": "create-efforge",
  "version": "0.1.0",
  "license": "MIT",
  "bin": {
    "create-efforge": "dist/bin.js",
    "efforge": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "start": "node src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5",
    "jsonc-parser": "3.3.1",
    "picocolors": "1.1.1",
    "ts-morph": "28.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "26.6.5",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.4.2"
}
