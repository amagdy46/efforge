{
  "id": "extras/email",
  "title": "Email",
  "description": "Fixture email.",
  "files": [
    {
      "path": "files/mailer.ts",
      "target": "apps/web/src/mailer.ts"
    },
    {
      "path": "files/pg-outbox.ts",
      "target": "apps/web/src/outbox.ts",
      "when": {
        "database": ["postgres"]
      }
    }
  ],
  "dependencies": {
    "apps/web": ["effect"]
  },
  "devDependencies": {},
  "envVars": [
    {
      "name": "DATABASE_URL",
      "example": "postgres://other/app",
      "description": "dup"
    },
    {
      "name": "MAIL_FROM",
      "example": "hi@example.com",
      "description": "Sender"
    }
  ],
  "requires": [],
  "conflicts": [],
  "transforms": [
    {
      "name": "addLayer",
      "args": {
        "file": "apps/web/src/layers.ts",
        "import": "MailerLive",
        "from": "./mailer.ts",
        "layer": "MailerLive"
      }
    }
  ]
}
