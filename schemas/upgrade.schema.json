              ]
            },
            "extras": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "workflows",
                  "realtime",
                  "browser",
                  "storage",
                  "email",
                  "cluster"
                ]
              }
            }
          },
          "required": [
            "name",
            "runtime",
            "database",
            "orm",
            "auth",
            "infra",
            "ai",
            "extras"
          ],
          "additionalProperties": true
        },
        "efforgeVersion": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string",
              "description": "What efforge.jsonc records now."
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": true
        },
        "status": {
          "type": "string",
          "enum": [
            "needs-action",
            "current"
          ],
          "description": "After applying: needs-action when something efforge can't fix still breaks the project (exit code 2)."
        },
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "installed": {
          "type": "boolean",
          "description": "pnpm install ran."
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "Where the local value is read from (.dev.vars, or .env with Alchemy)."
              },
              "set": {
                "type": "boolean",
                "description": "efforge already wrote a working local value; false means fill it in."
              },
              "secret": {
                "type": "boolean",
                "description": "The value is a secret: the deployed one is never printed or committed."
              }
            },
            "required": [
              "name",
              "description",
              "file",
              "set",
              "secret"
            ],
            "additionalProperties": true
          },
          "description": "Env vars added to .env.example (and to the local settings file when there is one), as create and add report them."
        },
        "kept": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "review",
                  "held",
                  "dropped"
                ],
                "description": "review: you changed it and so did efforge's template; held: efforge's, held back to keep the project consistent; dropped: efforge no longer generates it, and you changed it."
              },
              "reason": {
                "type": "string"
              },
              "lines": {
                "type": "string",
                "description": "The exact lines that would let efforge apply it."
              }
            },
            "required": [
              "path",
              "status",
              "reason"
            ],
            "additionalProperties": true
          },
          "description": "Files upgrade won't change for you, each with why."
        },
        "needsAction": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "effect-overrides",
                  "package-manager",
                  "split-set",
                  "missing-seam",
                  "install"
                ]
              },
              "message": {
                "type": "string"
              },
              "fix": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "A command after which this is fixed, or null (then `message` and `lines` say what to change)."
              },
              "lines": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "message",
              "fix"
            ],
            "additionalProperties": true
          },
          "description": "What breaks the project now. Not empty: exit code 2."
        },
        "nextSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "cwd": {
                "type": "string"
              }
            },
            "required": [
              "command",
              "cwd"
            ],
            "additionalProperties": true
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff": {
          "type": "string",
          "description": "With --diff: what it changed, as a git diff."
        }
      },
      "required": [
        "efforge",
        "contract",
        "ok",
        "check",
        "dryRun",
        "directory",
        "stack",
        "efforgeVersion",
        "status",
        "created",
        "changed",
        "removed",
        "installed",
        "env",
        "kept",
        "needsAction",
        "nextSteps",
        "warnings"
      ],
      "additionalProperties": true,
      "title": "efforge upgrade --json"
    }
  ],
  "title": "efforge upgrade --json"
}
