                "none"
              ]
            },
            "orm": {
              "type": "string",
              "enum": [
                "drizzle",
                "effect-sql",
                "none"
              ]
            },
            "auth": {
              "type": "string",
              "enum": [
                "better-auth-orgs",
                "better-auth",
                "none"
              ]
            },
            "infra": {
