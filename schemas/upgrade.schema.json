        },
        "ok": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "check": {
          "type": "boolean",
          "enum": [
            false
          ],
          "description": "`upgrade`: it applied (or, with --dry-run, would apply)."
        },
        "dryRun": {
          "type": "boolean"
        },
        "directory": {
          "type": "string"
        },
        "stack": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "runtime": {
              "anyOf": [
                {
                  "type": "string",
