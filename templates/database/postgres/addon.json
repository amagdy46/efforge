{
  "id": "database/postgres",
  "title": "Postgres",
  "description": "Postgres reached through a Hyperdrive binding on Workers, with a local docker-compose database and the `@repo/db` package.",
  "files": [
    {
      "path": "files/docker-compose.yml",
      "target": "docker-compose.yml"
    },
    {
      "path": "files/package.json",
      "target": "packages/db/package.json"
    },
    {
      "path": "files/tsconfig.json",
      "target": "packages/db/tsconfig.json"
    },
    {
      "path": "files/runtime.ts",
      "target": "apps/web/src/server/runtime.ts"
    }
  ],
  "dependencies": {
    "apps/web": [
      "@repo/db"
    ],
    "packages/db": [
      "@repo/core",
      "@effect/sql-pg",
      "effect",
      "effect-cf"
    ],
    "packages/core": [
      "@effect/sql-pg"
    ]
  },
  "devDependencies": {
    "packages/db": [
      "@cloudflare/workers-types",
      "@types/node",
      "typescript"
    ],
    "packages/core": [
      "@cloudflare/workers-types"
    ]
  },
  "envVars": [
    {
      "name": "DATABASE_URL",
      "example": "postgres://postgres:postgres@localhost:5432/app",
      "description": "Used by `pnpm db:migrate` and drizzle-kit; the running app connects through the HYPERDRIVE binding."
    }
  ],
  "requires": [],
  "conflicts": [],
  "transforms": [
    {
      "name": "addWranglerBinding",
      "args": {
        "key": "hyperdrive",
        "value": "{\"binding\": \"HYPERDRIVE\", \"id\": \"00000000000000000000000000000000\", \"localConnectionString\": \"postgres://postgres:postgres@localhost:5432/app\"}"
      },
      "when": {
        "infra": [
          "none"
        ]
      }
    },
    {
      "name": "addImport",
      "args": {
        "file": "infra/alchemy.run.ts",
        "import": "* as Config",
        "from": "effect/Config"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    },
    {
      "name": "addImport",
      "args": {
        "file": "infra/alchemy.run.ts",
        "import": "* as Redacted",
        "from": "effect/Redacted"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    },
    {
      "name": "addAlchemyResource",
      "args": {
        "name": "hyperdrive",
        "code": "const databaseUrl = new URL(Redacted.value(yield* Config.Redacted(\"DATABASE_URL\")))\nconst hyperdrive = yield* Cloudflare.Hyperdrive.Connection(\"Hyperdrive\", {\n  origin: {\n    scheme: \"postgres\",\n    host: databaseUrl.hostname,\n    port: Number(databaseUrl.port || 5432),\n    database: databaseUrl.pathname.slice(1),\n    user: decodeURIComponent(databaseUrl.username),\n    password: Redacted.make(decodeURIComponent(databaseUrl.password)),\n  },\n  // writes must be visible to the next read, so only pool connections, don't cache queries\n  caching: { disabled: true },\n})",
        "binding": "HYPERDRIVE"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    }
  ],
  "scripts": {
    ".": {
      "db:migrate": "pnpm --filter @repo/db db:migrate"
    }
  }
}
