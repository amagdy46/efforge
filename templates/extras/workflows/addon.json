{
  "id": "extras/workflows",
  "title": "Workflows",
  "description": "Durable background jobs: a Jobs service on Cloudflare Workflows, with an example workflow and server functions.",
  "docs": "https://github.com/amagdy46/efforge/blob/main/docs/addons/extras-workflows.md",
  "files": [
    {
      "path": "files/core-jobs.ts",
      "target": "packages/core/src/jobs.ts"
    },
    {
      "path": "files/Example.ts",
      "target": "apps/web/src/workflows/Example.ts"
    },
    {
      "path": "files/jobs.ts",
      "target": "apps/web/src/server/jobs.ts"
    },
    {
      "path": "files/example-job.ts",
      "target": "apps/web/src/server/example-job.ts"
    }
  ],
  "dependencies": {},
  "devDependencies": {},
  "envVars": [],
  "requires": [],
  "conflicts": [],
  "guide": {
    "purpose": "Durable background jobs on Cloudflare Workflows. Start a job and read its status through the `Jobs` service; Cloudflare runs the workflow's steps and keeps their results, so a job survives restarts. `apps/web/src/workflows/Example.ts` is a workflow to copy.",
    "service": {
      "name": "Jobs",
      "file": "packages/core/src/jobs.ts",
      "errors": [
        "JobError"
      ]
    }
  },
  "transforms": [
    {
      "name": "addExport",
      "args": {
        "file": "packages/core/src/index.ts",
        "export": "*",
        "from": "./jobs"
      }
    },
    {
      "name": "addExport",
      "args": {
        "file": "apps/web/src/server.ts",
        "export": "Example",
        "from": "./workflows/Example"
      }
    },
    {
      "name": "addLayer",
      "args": {
        "file": "apps/web/src/server/layers.ts",
        "import": "JobsLive",
        "from": "./jobs",
        "layer": "JobsLive"
      }
    },
    {
      "name": "addWranglerBinding",
      "args": {
        "key": "workflows",
        "value": "{\"name\":\"example\",\"binding\":\"EXAMPLE_WORKFLOW\",\"class_name\":\"Example\"}"
      },
      "when": {
        "infra": [
          "none"
        ]
      }
    },
    {
      "name": "addAlchemyResource",
      "args": {
        "name": "exampleWorkflow",
        "code": "const exampleWorkflow = Cloudflare.Workflow(\"Example\", { className: \"Example\" })",
        "binding": "EXAMPLE_WORKFLOW"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    },
    {
      "name": "addServerFnMiddleware",
      "args": {
        "file": "apps/web/src/server/example-job.ts",
        "middleware": "requireSession",
        "import": "requireSession",
        "from": "./require-session"
      },
      "when": {
        "auth": [
          "better-auth",
          "better-auth-orgs"
        ]
      }
    }
  ]
}
