  "dependencies": {
    "apps/web": [
      "better-auth"
    ]
  },
  "devDependencies": {},
  "envVars": [
    {
      "name": "BETTER_AUTH_SECRET",
      "example": "change-me-to-a-long-random-string",
      "description": "Signs sessions and cookies (local: .dev.vars; production: wrangler secret put BETTER_AUTH_SECRET)"
    },
    {
      "name": "BETTER_AUTH_URL",
      "example": "http://localhost:5173",
      "description": "Public origin of the app, used for redirects and trusted origins (a Worker var in production)"
    }
  ],
  "requires": [],
  "conflicts": [],
  "transforms": [
    {
      "name": "addDevVar",
      "args": {
        "name": "BETTER_AUTH_SECRET",
        "value": "dev-only-secret-replace-me-with-openssl-rand-base64-32"
      }
    },
    {
      "name": "addDevVar",
      "args": {
        "name": "BETTER_AUTH_URL",
        "value": "http://localhost:5173"
      }
    },
    {
      "name": "addExport",
      "args": {
        "file": "packages/core/src/index.ts",
        "export": "*",
        "from": "./Auth"
      }
    },
    {
      "name": "addImport",
      "args": {
        "file": "apps/web/src/server/layers.ts",
        "import": "AuthLive",
        "from": "./auth-live"
      }
    },
    {
      "name": "addLayer",
      "args": {
        "file": "apps/web/src/server/layers.ts",
        "import": "AuthLive",
        "from": "./auth-live",
        "layer": "AuthLive"
      }
    },
    {
      "name": "addArrayItem",
      "args": {
        "file": "apps/web/src/server/routes.ts",
        "name": "workerRoutes",
        "item": "authRoute",
        "import": "authRoute",
        "from": "./auth-route"
      }
    },
    {
      "name": "addExport",
      "args": {
        "file": "packages/db/src/index.ts",
        "export": "*",
        "from": "./auth-schema.ts"
      },
      "when": {
        "orm": [
          "drizzle"
        ]
      }
    },
    {
      "name": "addImport",
      "args": {
        "file": "infra/alchemy.run.ts",
        "import": "* as Config",
        "from": "effect/Config"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    },
    {
      "name": "addAlchemyResource",
      "args": {
        "name": "betterAuthSecret",
        "code": "const betterAuthSecret = yield* Config.Redacted(\"BETTER_AUTH_SECRET\")",
        "binding": "BETTER_AUTH_SECRET"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    },
    {
      "name": "addAlchemyResource",
      "args": {
        "name": "betterAuthUrl",
        "code": "// the public origin; empty lets Better Auth infer it from each request (right for PR previews)\nconst betterAuthUrl = yield* Config.String(\"BETTER_AUTH_URL\").pipe(Config.withDefault(\"\"))",
        "binding": "BETTER_AUTH_URL"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    },
    {
      "name": "addWorkflowSecret",
      "args": {
        "name": "BETTER_AUTH_SECRET"
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    },
    {
      "name": "appendAgentsSection",
      "args": {
        "id": "auth",
        "content": "## Auth (Better Auth)\n\n- Server: `apps/web/src/server/auth.ts` builds the Better Auth instance (`makeAuth`); `auth-live.ts` provides it and the `Auth` service from `@repo/core`. Read the session in Effect code through `Auth.currentSession`, never from cookies directly.\n- `/api/auth/*` is served by `auth-route.ts` (a `workerRoutes` entry). Client: `authClient` in `apps/web/src/lib/auth-client.ts`.\n- Route guard: `routes/app.tsx` redirects signed-out visitors to `/sign-in?redirect=...`; build redirects with `safeRedirect`, never from raw input."
      }
    },
    {
      "name": "appendAgentsSection",
      "args": {
        "id": "auth-schema",
        "content": "- Auth tables are in `packages/db/src/auth-schema.ts` (Drizzle); after changing Better Auth plugins regenerate the schema and generate a new migration in `packages/db/drizzle/`, never edit applied ones."
      },
      "when": {
        "orm": [
          "drizzle"
        ]
      }
    },
    {
      "name": "appendAgentsSection",
      "args": {
        "id": "auth-schema",
        "content": "- Auth tables are plain SQL in `packages/db/migrations/0002_auth.sql`; after changing Better Auth plugins add a new migration file, never edit applied ones."
      },
      "when": {
        "orm": [
          "effect-sql"
        ]
      }
    },
    {
      "name": "appendAgentsSection",
      "args": {
        "id": "auth-secret",
        "content": "- `BETTER_AUTH_SECRET` signs sessions: set it as a Worker secret (`.dev.vars` locally, `wrangler secret put BETTER_AUTH_SECRET` in production). Never log or return it. `BETTER_AUTH_URL` is the public origin; when unset Better Auth infers it from the request."
      },
      "when": {
        "infra": [
          "none"
        ]
      }
    },
    {
      "name": "appendAgentsSection",
      "args": {
        "id": "auth-secret",
        "content": "- `BETTER_AUTH_SECRET` signs sessions: Alchemy passes it to the Worker from `.env` locally and from the deploy workflow secret in CI. Never log or return it. `BETTER_AUTH_URL` is the public origin; when unset Better Auth infers it from the request."
      },
      "when": {
        "infra": [
          "alchemy"
        ]
      }
    }
  ]
}
