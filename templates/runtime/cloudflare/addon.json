{
  "id": "runtime/cloudflare",
  "title": "Cloudflare Workers",
  "description": "Runs the app on Cloudflare Workers via @cloudflare/vite-plugin.",
  "files": [
    {
      "path": "files/server.ts",
      "target": "apps/web/src/server.ts"
    },
    {
      "path": "files/cloudflare.ts",
      "target": "apps/web/src/server/cloudflare.ts"
    },
    {
      "path": "files/routes.ts",
      "target": "apps/web/src/server/routes.ts"
    },
    {
      "path": "files/tsconfig.json",
      "target": "apps/web/tsconfig.json"
    },
    {
      "path": "files/vite.config.ts",
      "target": "apps/web/vite.config.ts"
    },
    {
      "path": "files/wrangler.jsonc",
      "target": "wrangler.jsonc",
      "when": {
        "infra": [
          "none"
        ]
      }
    }
  ],
  "dependencies": {
    "apps/web": [
      "effect-cf"
    ]
  },
  "devDependencies": {
    "apps/web": [
      "@cloudflare/vite-plugin",
      "@cloudflare/workers-types",
      "wrangler"
    ]
  },
  "envVars": [],
  "requires": [],
  "conflicts": [],
  "guide": {
    "purpose": "Every project has it. The app runs as one Cloudflare Worker, and `@cloudflare/vite-plugin` runs that Worker in workerd during `pnpm dev`. It owns two files the rest of the app is built around: `apps/web/src/server.ts`, the Worker entry, and `apps/web/src/server/cloudflare.ts`, the one file that reads the Worker environment.",
    "limits": [
      "Cloudflare is the only runtime."
    ]
  },
  "transforms": []
}
