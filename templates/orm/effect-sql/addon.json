{
  "id": "orm/effect-sql",
  "title": "Effect SQL",
  "description": "Plain Effect SQL (tagged-template queries) behind the Database service; migrations are SQL files.",
  "docs": "https://github.com/amagdy46/efforge/blob/main/docs/addons/orm-effect-sql.md",
  "files": [
