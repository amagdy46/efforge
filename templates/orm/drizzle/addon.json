  "dependencies": {
    "apps/web": [
      "drizzle-orm"
    ],
    "packages/core": [
      "drizzle-orm"
    ],
    "packages/db": [
      "drizzle-orm"
    ]
  },
  "devDependencies": {
    "packages/db": [
      "drizzle-kit"
    ]
  },
  "scripts": {
    "packages/db": {
      "db:generate": "drizzle-kit generate"
    }
  },
  "envVars": [],
  "requires": [],
  "conflicts": [],
  "transforms": [
    {
      "name": "addImport",
      "args": {
        "file": "apps/web/src/server/layers.ts",
        "import": "WorkerEnvLive",
        "from": "./cloudflare"
      }
    },
    {
      "name": "addLayer",
      "args": {
        "file": "apps/web/src/server/layers.ts",
        "import": "DatabaseLayer",
        "from": "@repo/db",
        "layer": "DatabaseLayer.pipe(Layer.provide(WorkerEnvLive))"
      }
    }
  ]
